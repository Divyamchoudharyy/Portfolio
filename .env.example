# Required: create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Required for shared rate limiting on Vercel Preview and Production.
# Create a Redis database at https://console.upstash.com/ and copy its REST URL and token.
# Local development uses an in-memory fallback if these are not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
